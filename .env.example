# Firebase (public config — safe to expose)
VITE_FIREBASE_API_KEY=AIzaSy-your-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# Backend URL (Cloud Run after deploy)
VITE_API_URL=https://lifeos-api-xxx-uc.a.run.app

# Backend only — NEVER put real key here, use Secret Manager
# GEMINI_API_KEY is loaded from Secret Manager at runtime
GOOGLE_CLOUD_PROJECT=your-project-id
PORT=8080
